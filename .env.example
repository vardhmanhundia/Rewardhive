# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/card_db

SQL_ECHO=False

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production

# API Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# LLM Configuration (Meta Muse via the Meta Model API)
MODEL_API_KEY=your-meta-model-api-key
MUSE_BASE_URL=https://api.meta.ai/v1

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-key-here
LANGSMITH_PROJECT=rewardhive

# Embeddings (shared by seeding and retrieval — both sides must match)
# Default: self-hosted sentence-transformers, native on arm64 / Python 3.13.
EMBEDDING_PROVIDER=sentence_transformers
ST_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024
# To use Meta's SONAR instead (needs the [sonar] extra, x86_64 + Python<=3.12):
# EMBEDDING_PROVIDER=sonar

# Frontend Configuration
VITE_API_URL=http://localhost:8000

# Public base URL of the web app, used to build links in outgoing emails.
FRONTEND_URL=http://localhost:3000

# Transactional email (conversation share invites).
# Fake mode (default) logs emails instead of sending — no SMTP server needed
# locally. Set EMAIL_FAKE_MODE=false and the SMTP_* vars to deliver for real.
EMAIL_FAKE_MODE=true
EMAIL_FROM=RewardHive <no-reply@rewardhive.app>
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
