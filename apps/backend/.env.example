# Database Configuration
# SQLite (development - default):
DATABASE_URL=sqlite:///./test.db

# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/card_db

SQL_ECHO=False

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production

# API Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# LLM Configuration
OPENAI_API_KEY=your-openai-api-key
LANGCHAIN_API_KEY=your-langchain-api-key

# Embeddings (shared by seeding and retrieval — both sides must match)
# Default: self-hosted sentence-transformers, native on arm64 / Python 3.13.
EMBEDDING_PROVIDER=sentence_transformers
ST_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024
# To use Meta's SONAR instead (needs the [sonar] extra, x86_64 + Python<=3.12):
# EMBEDDING_PROVIDER=sonar

# Frontend Configuration
VITE_API_URL=http://localhost:8000
