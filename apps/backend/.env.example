# Database Configuration
# Hybrid dev (recommended): Postgres runs in Docker (`make infra`), backend on
# the host. The app uses the async engine, so the URL must use the asyncpg
# scheme and point at localhost (the container publishes 5432 to the host).
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/card_db

# SQLite instead (no Docker): must be the async driver, not plain sqlite://
# DATABASE_URL=sqlite+aiosqlite:///./test.db

SQL_ECHO=False

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production

# API Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# LLM Configuration (Meta Muse via the OpenAI-compatible Meta Model API)
MODEL_API_KEY=your-meta-model-api-key
MUSE_BASE_URL=https://your-meta-model-api-base-url
# Optional: override default models (default: muse-spark-1.1)
# PROFILING_CHAT_MODEL=muse-spark-1.1
# PROFILING_EXTRACTOR_MODEL=muse-spark-1.1
# Replay canned responses instead of calling the API (offline/testing)
# LLM_FAKE_MODE=false

# LangSmith tracing (optional)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-key-here
LANGSMITH_PROJECT=rewardhive
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Embeddings (shared by seeding and retrieval — both sides must match)
# Default: self-hosted sentence-transformers, native on arm64 / Python 3.13.
EMBEDDING_PROVIDER=sentence_transformers
ST_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024
# To use Meta's SONAR instead (needs the [sonar] extra, x86_64 + Python<=3.12):
# EMBEDDING_PROVIDER=sonar

# Frontend Configuration
VITE_API_URL=http://localhost:8000
