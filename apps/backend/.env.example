# Database Configuration
# SQLite (development - default):
DATABASE_URL=sqlite:///./test.db

# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/card_db

SQL_ECHO=False

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production

# API Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# LLM Configuration (Meta Muse via the OpenAI-compatible Meta Model API)
MODEL_API_KEY=your-meta-model-api-key
MUSE_BASE_URL=https://your-meta-model-api-base-url
# Optional: override default models (default: muse-spark-1.1)
# PROFILING_CHAT_MODEL=muse-spark-1.1
# PROFILING_EXTRACTOR_MODEL=muse-spark-1.1
# Replay canned responses instead of calling the API (offline/testing)
# LLM_FAKE_MODE=false

# LangSmith tracing (optional)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-key-here
LANGSMITH_PROJECT=rewardhive
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Frontend Configuration
VITE_API_URL=http://localhost:8000
